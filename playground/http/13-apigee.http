### Basic Auth com valores invalidos do cenario local
# @name apigeeUnauthorized
GET {{apigeeUrl}}/demo/secure
Authorization: {{gatewayInvalidAuth}}

?? status == 401

### Basic Auth com os dados publicos de demonstracao
# @name apigeeAuthorized
GET {{apigeeUrl}}/demo/secure
Authorization: {{gatewayAuth}}

?? status == 200
{{
  test("Policy autoriza o acesso ao recurso protegido", () => {
    const assert = require("assert");
    assert.ok(response.parsedBody.authenticatedUser);
    assert.strictEqual(response.parsedBody.secretData.environment, "development");
    assert.deepStrictEqual(response.parsedBody.secretData.permissions, ["read", "write", "admin"]);
  });
}}

