### Proxy implantado: backend e headers aplicados pelo PostFlow
# @name apigeeRoot
GET {{apigeeUrl}}/demo/

?? status == 200
?? body includes Hello from BackendApi
?? header X-Proxy-Name == demo-api
?? header Access-Control-Allow-Origin == *

### Readiness do proxy (a API pronta sozinha nao garante o deploy)
# @name apigeeHealth
GET {{apigeeUrl}}/demo/health

?? status == 200
?? body includes healthy

### Metadados da requisicao encaminhada ao backend
# @name apigeeEcho
GET {{apigeeUrl}}/demo/echo?source=httpyac
X-Httpyac-Scenario: apigee-echo

?? status == 200
{{
  test("Proxy encaminha metodo, caminho e header", () => {
    const assert = require("assert");
    assert.strictEqual(response.parsedBody.method, "GET");
    assert.strictEqual(response.parsedBody.path, "/echo");
    const header = Object.entries(response.parsedBody.headers).find(([name]) => name.toLowerCase() === "x-httpyac-scenario");
    assert.ok(header);
    assert.strictEqual(header[1], "apigee-echo");
  });
}}

### Envelope JSON aplicado pela policy JavaScript
# @name apigeeTransform
GET {{apigeeUrl}}/demo/transform

?? status == 200
{{
  test("Transformacao preserva produtos e acrescenta metadados", () => {
    const assert = require("assert");
    const body = response.parsedBody;
    assert.strictEqual(body.status, "ok");
    assert.strictEqual(body.code, 200);
    assert.strictEqual(body.data.total, 3);
    assert.strictEqual(body.data.products.length, 3);
    assert.strictEqual(body.metadata.transformedBy, "JS-TransformResponse");
  });
}}

