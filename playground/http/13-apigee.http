### Cache com chave exclusiva: primeira leitura
# @name apigeeCacheInitial
{{
  exports.apigeeCacheRun = require("crypto").randomUUID();
}}
GET {{apigeeUrl}}/demo/cached?httpyac={{apigeeCacheRun}}

?? status == 200
?? header X-Cache == MISS

### Mesma chave: observar o cache (TTL configurado de 30 segundos; o emulador pode repetir MISS)
# @name apigeeCacheHit
# @ref apigeeCacheInitial
GET {{apigeeUrl}}/demo/cached?httpyac={{apigeeCacheRun}}

?? status == 200
{{
  test("Resposta informa o estado do cache e preserva o contrato", () => {
    const assert = require("assert");
    const header = Object.entries(response.headers).find(([name]) => name.toLowerCase() === "x-cache");
    assert.ok(header);
    const state = String(header[1]);
    assert.ok(["HIT", "MISS"].includes(state));
    assert.strictEqual(response.parsedBody.data.metrics.cpu, 42.5);
    assert.ok(Number.isFinite(Date.parse(response.parsedBody.generatedAt)));
    if (state === "HIT") {
      assert.deepStrictEqual(response.parsedBody, apigeeCacheInitial);
    }
  });
}}

