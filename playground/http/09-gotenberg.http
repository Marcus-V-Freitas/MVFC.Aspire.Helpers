?? header content-type includes application/pdf
{{
  test("Gotenberg retorna um arquivo PDF", () => {
    const bytes = Buffer.from(response.body);
    require("assert").strictEqual(bytes.subarray(0, 5).toString("ascii"), "%PDF-");
  });
}}
