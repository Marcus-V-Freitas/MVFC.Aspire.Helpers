<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CompatibilityPackageVersion Condition="'$(CompatibilityPackageVersion)' == ''">12.0.0</CompatibilityPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MVFC.Aspire.Helpers.Mongo" Version="$(CompatibilityPackageVersion)" />
    <PackageReference Include="MVFC.Aspire.Helpers.Redis" Version="$(CompatibilityPackageVersion)" />
    <PackageReference Include="MVFC.Aspire.Helpers.RabbitMQ" Version="$(CompatibilityPackageVersion)" />
    <PackageReference Include="MVFC.Aspire.Helpers.GcpSpanner" Version="$(CompatibilityPackageVersion)" />
    <PackageReference Include="MVFC.Aspire.Helpers.WireMock" Version="$(CompatibilityPackageVersion)" />
  </ItemGroup>
</Project>
